*.egg
MANIFEST

# ==============================================================================
# DJANGO SPECIFIC
# ==============================================================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# File statici raccolti (generati da collectstatic/whitenoise)
# Non committare mai questi file, vengono generati in build time
src/staticfiles/
src/media/

# ==============================================================================
# ENVIRONMENT & SECRETS (CRITICAL)
# ==============================================================================
# Ignora qualsiasi file di ambiente reale
.env
.env.local
.env.production
.env.test

# ECCEZIONE: Mantieni l'esempio per i developer
! .env.example

# ==============================================================================
# DEPENDENCY MANAGEMENT (POETRY)
# ==============================================================================
# Ignoriamo il virtualenv locale (se creato in-project)
.venv/
venv/
ENV/
env/

# NOTA: poetry.lock DEVE essere committato per garantire build riproducibili
# Quindi NON lo ignoriamo.

# ==============================================================================
# TESTING & COVERAGE
# ==============================================================================
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# ==============================================================================
# CELERY & ASYNC
# ==============================================================================
celerybeat-schedule
celerybeat.pid

# ==============================================================================
# DOCKER
# ==============================================================================
# Ignoriamo file di override locali per docker-compose
docker-compose.override.yml

