**/build-scan-data
**/reports

# ==========================================
# 4. LOCAL CONFIGURATION & SECRETS
# ==========================================
# Contains absolute paths to SDKs and potentially secrets. NEVER COMMIT.
local.properties
# Environment variables
.env
.env.*

